# Copy to .env for local dev: cp .env.example .env
# On Render: Dashboard → Web Service → Environment → add the same keys (use Secret for API keys).

APP_NAME=CreditSaathi API
ENVIRONMENT=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/creditsaathi

JWT_SECRET=
JWT_REFRESH_SECRET=

ML_SERVICE_URL=http://localhost:8000

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL_ID=nvidia/nemotron-3-super-120b-a12b:free
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer

OPENROUTER_API_KEY=

# Sarvam speech-to-text (required for voice transcript in chat)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_MODE=
SARVAM_LANGUAGE_CODE=unknown

ALLOWED_ORIGIN=http://localhost:3000
